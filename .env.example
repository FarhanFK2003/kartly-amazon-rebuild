# Kartly - local environment template.
#
# Copy to .env and fill in real values. .env is git-ignored; this file is the
# tracked template and must never contain a real credential.
#
#   cp .env.example .env
#
# Next.js loads .env for the application. The Prisma CLI does not load it on its
# own in version 7, so prisma.config.ts reads it explicitly - see docs/backend.md.

# PostgreSQL connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional. Connection used for migrations and seeding; DATABASE_URL is used
# when this is absent. Managed providers (Neon, Supabase) issue a POOLED url for
# DATABASE_URL that cannot run DDL, and DIRECT_URL must then be the non-pooled
# one. Running against a local PostgreSQL, leave this unset.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
