// Kartly database schema.
//
// Modelled from the real catalogue in data/catalog.json, which is now a seed
// source rather than the runtime product store.
//
// Two decisions worth recording:
//
//   * Product.id is the catalogue id ("electronics-01"), not a generated key.
//     Those ids are already in PDP URLs, cart lines, related-product links and
//     the QA suites, so generating new ones would break the application. The
//     slug is unique too, because /dp/[id] resolves by either.
//
//   * specs is Json because it is genuinely variable: 120 products carry 115
//     distinct key sets. A spec table would be a key/value bag with no schema
//     value. Everything else here is structured, so it is modelled relationally.
//
// ratingHistogram is stored rather than derived: reviewCount runs to thousands
// while only a handful of review bodies exist per product, so the histogram
// describes ratings the review table does not contain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 removed `url` and `directUrl` from this block. The connection
  // string for migrations now lives in prisma.config.ts, and the one the
  // application uses is handed to PrismaClient as a driver adapter in lib/db.ts.
  // Nothing in this file reads an environment variable any more.
  provider = "postgresql"
}

enum VariantType {
  color
  size
}

enum Badge {
  choice
  deal
  sponsored
  bestSeller
  lowStock
}

model Category {
  id         String    @id
  slug       String    @unique
  name       String
  blurb      String
  imageQuery String
  /// Catalogue order, so departments list the same way every time.
  position   Int
  products   Product[]

  @@map("categories")
}

model Brand {
  id       String    @id
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  /// The catalogue id. Stable, external, and already in URLs.
  id              String   @id
  slug            String   @unique
  title           String
  /// Minor units, matching lib/commerce.ts. Never a float.
  price           Int
  listPrice       Int?
  dealPercent     Int      @default(0)
  rating          Float
  reviewCount     Int
  ratingHistogram Json
  image           String?
  imageQuery      String
  bullets         String[]
  specs           Json
  stock           Int
  isPrime         Boolean  @default(false)
  deliveryDays    Int
  boughtLastMonth Int      @default(0)
  badges          Badge[]
  /// Catalogue order, so an unsorted query is still deterministic.
  position        Int

  categoryId String
  brandId    String

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand            @relation(fields: [brandId], references: [id])
  variants  ProductVariant[]
  reviews   Review[]
  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([price])
  @@index([rating])
  @@index([position])
  @@map("products")
}

model ProductVariant {
  /// The catalogue variant id, referenced by cart lines.
  id         String      @id
  productId  String
  type       VariantType
  label      String
  swatch     String?
  priceDelta Int         @default(0)
  /// The product detail page selects the first variant by default, so order
  /// is behaviour rather than presentation and has to survive the database.
  position   Int

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id        String   @id
  productId String
  author    String
  rating    Int
  title     String
  body      String
  date      DateTime @db.Date
  verified  Boolean  @default(false)
  helpful   Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

/* ------------------------------------------------------------------ */
/* Cart and orders (wave 6C)                                           */
/* ------------------------------------------------------------------ */

/// A guest cart, owned by an opaque session cookie rather than an account.
/// Authentication is not part of this stage, so the session id is the only
/// identity a cart has - see lib/session.ts.
model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  /// variantId with null collapsed to "", because PostgreSQL treats NULLs as
  /// distinct in a unique index - without it the same product could be added
  /// twice with no variant and produce two lines instead of one.
  variantKey String
  qty       Int
  /// Moved out of the active cart but kept on the cart page.
  saved     Boolean @default(false)
  /// Insertion order, so the cart lists the same way on every read.
  position  Int

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cartId, productId, variantKey])
  @@index([cartId])
  @@map("cart_items")
}

enum OrderStatus {
  placed
  confirmed
  shipped
  delivered
  cancelled
}

/// A placed order. Every money column is written by the server from
/// lib/commerce.ts; nothing here is ever taken from the browser.
///
/// No card number, expiry or CVV is stored - only the method and, for a
/// simulated card, the last four digits the confirmation screen displays.
model Order {
  /// The KTL-XXXXXX-XXX id the UI already shows.
  id        String      @id
  /// Owning guest session. Set for every order; it is what a signed-out
  /// shopper is identified by.
  sessionId String
  /// Owning account, when the order was placed while signed in.
  ///
  /// Without this, orders belonged to the browser rather than the person: two
  /// people signing into the same browser inherited each other's history,
  /// because the guest cookie does not change when an account does.
  userId    String?
  status    OrderStatus @default(placed)

  subtotal  Int
  shipping  Int
  tax       Int
  total     Int
  itemCount Int

  shipFullName String
  shipLine1    String
  shipLine2    String?
  shipCity     String
  shipState    String
  shipZip      String
  shipPhone    String

  paymentMethod String
  paymentBrand  String?
  paymentLast4  String?

  deliveryDate DateTime @db.Date

  /// Set by the client per checkout attempt. Unique, so a resubmitted form
  /// returns the original order instead of creating a second one.
  idempotencyKey String? @unique

  placedAt DateTime @default(now())

  items OrderItem[]
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([placedAt])
  @@map("orders")
}

/// A line of a placed order, stored as a snapshot.
///
/// productId and variantId are plain columns rather than foreign keys on
/// purpose: a past order must keep showing what was actually bought, at the
/// price it was bought for, even if the catalogue later changes or the product
/// is removed. A cascade or a SET NULL would let a catalogue edit rewrite
/// history.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  slug         String
  title        String
  image        String?
  variantLabel String?
  qty          Int
  /// What this unit actually cost at the moment of purchase.
  unitPrice    Int
  position     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/* ------------------------------------------------------------------ */
/* Accounts                                                            */
/* ------------------------------------------------------------------ */

/// A real account. Deliberately minimal: an identity and a password, nothing
/// else. No profile, no addresses, no payment methods.
model User {
  id           String        @id @default(cuid())
  /// Stored trimmed and lowercased, so "  Ada@Example.COM " and
  /// "ada@example.com" cannot become two accounts.
  email        String        @unique
  /// A bcrypt hash. The plaintext is never stored, logged or returned.
  passwordHash String
  sessions     AuthSession[]
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

/// A signed-in session.
///
/// Only the SHA-256 of the token is stored. The raw token exists in one place -
/// an httpOnly cookie in the browser - so a leaked database dump cannot be
/// replayed as a login.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
